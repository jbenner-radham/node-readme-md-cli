{
  "name": "readme-md-cli",
  "version": "0.19.1",
  "description": "Automatically generate a readme for your project from the CLI.",
  "keywords": [
    "cli",
    "commonmark",
    "create",
    "creator",
    "docs",
    "documentation",
    "generate",
    "generator",
    "markdown",
    "md",
    "readme",
    "tty",
    "tui"
  ],
  "homepage": "https://github.com/jbenner-radham/node-readme-md-cli#readme",
  "bugs": {
    "url": "https://github.com/jbenner-radham/node-readme-md-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbenner-radham/node-readme-md-cli.git"
  },
  "license": "MIT",
  "author": "James Benner <james.benner@gmail.com> (https://www.jamesbenner.com/)",
  "type": "module",
  "exports": {
    "import": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "readme-md": "dist/cli.js"
  },
  "files": [
    ".config/readme-md",
    "dist",
    "doc",
    "example",
    "images",
    "template",
    "config.schema.json"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "postbuild": "plus-x dist/cli.js",
    "demo": "agg demo.cast images/demo.gif",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "prepare": "husky",
    "prereadme": "pnpm run build",
    "readme": "node dist/cli.js --non-interactive > README.md",
    "test": "vitest run --watch=false",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.1.0",
    "ajv": "^8.17.1",
    "camelcase-keys": "^10.0.0",
    "chalk": "^5.3.0",
    "execa": "^9.6.0",
    "is-file-in-cwd": "^0.1.0",
    "is-plain-obj": "^4.1.0",
    "js-yaml": "^4.1.0",
    "log-symbols": "^7.0.0",
    "meow": "^14.0.0",
    "readme-md": "^1.3.1",
    "type-fest": "^5.0.1",
    "yarn-lockfile-exists": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/js": "^9.15.0",
    "@radham/plus-x": "^0.2.0",
    "@types/command-exists": "^1.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "command-exists": "^1.2.9",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "rimraf": "^6.0.1",
    "sort-package-json": "^3.4.0",
    "tempy": "^3.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.5.0",
    "pnpm": ">=10.15.0"
  },
  "preferGlobal": true
}
